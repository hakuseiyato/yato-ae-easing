<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="8.0" ExtensionBundleId="com.yato.easing" ExtensionBundleVersion="0.1.0"
		ExtensionBundleName="Yato Easing" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ExtensionList>
		<Extension Id="com.yato.easing.panel" Version="0.1.0" />
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<Host Name="AEFT" Version="15.0" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="11.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="com.yato.easing.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./html/index.html</MainPath>
					<ScriptPath>./jsx/host.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>Yato Easing</Menu>
					<Geometry>
						<Size>
							<Height>480</Height>
							<Width>240</Width>
						</Size>
						<MinSize>
							<Height>400</Height>
							<Width>220</Width>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
